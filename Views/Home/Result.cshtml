@model List<CafeLocatorApp.Models.Cafe>

@{
    ViewData["Title"] = "Nearby Cafés";
}
<h2>Nearby Cafés</h2>
@if(Model.Count == 0){
    <p>No cafés found.</p>
}
else
{
    <table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Address</th>
            <th>Latitude</th>
            <th>Longitude</th>
        </tr>
    </thead>
    <tbody>
            @foreach(var cafe in Model)
            {
                <tr>
                    <td>@cafe.Name</td>
                    <td>@cafe.Address</td>
                    <td>@cafe.Latitude</td>
                    <td>@cafe.Longitude</td>
                </tr>
            }
        </tbody>

    </table>
}